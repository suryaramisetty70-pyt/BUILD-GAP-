PORT=3000
# Optional persistent PostgreSQL connection; configure through your hosting dashboard.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
# If DATABASE_URL is unset, SQLite is used. Mount this directory on persistent storage in production.
DB_PATH=./storage/gaplab.sqlite
# Enable only behind a trusted reverse proxy such as Render.
TRUST_PROXY=0
